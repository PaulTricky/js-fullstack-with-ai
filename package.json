{
  "name": "js-fullstack-with-ai",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "turbo": "^2.10.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bun --filter web dev",
    "dev:api": "bun --filter api start:dev",
    "lint": "biome check",
    "lint:fix": "biome check --unsafe --write .",
    "format": "biome format --write .",
    "generate": "turbo run generate"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/**"
  ]
}
